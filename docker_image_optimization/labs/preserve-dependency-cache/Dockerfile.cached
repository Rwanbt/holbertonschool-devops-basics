# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim
WORKDIR /app

# 1. Manifests first so any change to them invalidates the dependency layer
COPY package.json package-lock.json ./

# 2. The included local dependency before npm ci so the file: link resolves
COPY packages/message-format ./packages/message-format

# 3. Install production dependencies only; preserve the supplied no-op delay
#    so the experiment keeps the dependency step visibly expensive.
RUN npm ci --omit=dev && node -e "setTimeout(() => {}, 3000)"

# 4. Application source and tests are copied last, after node_modules exists
COPY src ./src
COPY test ./test

EXPOSE 8080
CMD ["node", "src/server.js"]